# ==================== Database ====================
MONGO_URI=mongodb://localhost:27017/vanbooking
MONGODB_URI=mongodb://localhost:27017/vanbooking

# ==================== Authentication ====================
JWT_SECRET=change-this-secret-key-in-production-2026
JWT_EXPIRES_IN=7d

# ==================== Server ====================
PORT=4000
CLIENT_URL=http://localhost:3000

# ==================== Uploads ====================
UPLOAD_DIR=./uploads

# ==================== Internal notifications ====================
# Shared secret expected from the driver backend when it broadcasts departure alerts.
DEPARTURE_NOTIFY_SECRET=change-this-secret

# ==================== Firebase (Optional) ====================
# Use one of the two options below for push notifications.
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-adminsdk.json
