# ==================== Database ====================
MONGO_URI=mongodb://localhost:27017/vanbooking
MONGODB_URI=mongodb://localhost:27017/vanbooking

# ==================== Authentication ====================
JWT_SECRET=change-this-secret-key-in-production-2026
JWT_EXPIRES_IN=7d

# ==================== Server ====================
PORT=4000
CLIENT_URL=http://localhost:8080

# Shared secret for internal departure notification bridge
DEPARTURE_NOTIFY_SECRET=local-departure-secret

# ==================== Uploads ====================
UPLOAD_DIR=./uploads

SEAT_HOLD_SECONDS=180
UNPAID_CUTOFF_MINUTES=10
PAID_LATE_MINUTES=5
